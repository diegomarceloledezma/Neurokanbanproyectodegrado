# =========================================================
# NeuroKanban - Variables de producción
# Copiar este archivo como .env.production y completar valores reales.
# =========================================================

# ---------------------------------------------------------
# Entorno
# ---------------------------------------------------------
ENVIRONMENT=production
APP_NAME=NeuroKanban
DEBUG=false

# ---------------------------------------------------------
# Dominio / URL pública
# ---------------------------------------------------------
# Sin dominio:
# PUBLIC_DOMAIN=IP_PUBLICA_DEL_SERVIDOR
# FRONTEND_URL=http://IP_PUBLICA_DEL_SERVIDOR
# BACKEND_CORS_ORIGINS=http://IP_PUBLICA_DEL_SERVIDOR
#
# Con dominio:
# PUBLIC_DOMAIN=neurokanban.conexionlab.org
# FRONTEND_URL=https://neurokanban.conexionlab.org
# BACKEND_CORS_ORIGINS=https://neurokanban.conexionlab.org

PUBLIC_DOMAIN=IP_PUBLICA_DEL_SERVIDOR
FRONTEND_URL=http://IP_PUBLICA_DEL_SERVIDOR
BACKEND_CORS_ORIGINS=http://IP_PUBLICA_DEL_SERVIDOR

# El frontend debe llamar al backend por el proxy de Caddy.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------
POSTGRES_DB=neurokanban
POSTGRES_USER=neurokanban

# Cambiar obligatoriamente en producción.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SEGURO

DATABASE_URL=postgresql+psycopg2://neurokanban:CAMBIAR_PASSWORD_POSTGRES_SEGURO@db:5432/neurokanban

# ---------------------------------------------------------
# Seguridad JWT
# ---------------------------------------------------------
# Generar una clave fuerte antes de desplegar.
# Ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_SECRET_KEY_LARGO_Y_SEGURO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------
# Usuario administrador inicial
# ---------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@neurokanban.app
INITIAL_ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD_SEGURO
INITIAL_ADMIN_FULL_NAME=Administrador NeuroKanban

# ---------------------------------------------------------
# Archivos y modelo IA
# ---------------------------------------------------------
UPLOAD_DIR=/app/uploads
ML_ARTIFACTS_DIR=/app/app/ml_artifacts

# Límite recomendado de archivo en bytes.
# 15 MB = 15728640
MAX_UPLOAD_SIZE=15728640